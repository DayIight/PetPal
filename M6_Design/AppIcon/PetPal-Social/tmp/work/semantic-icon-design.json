  "conversion_constraints": {
    "target_layer_count": "4",
    "svg_first": true,
    "allowed_svg_primitives": [
      "filled path",
      "ellipse",
      "rect"
    ],
    "forbidden_in_svg_assets": [
      "text",
      "image",
      "filter",
      "clipPath",
      "mask",
      "stroke",
      "opacity",
      "shadow",
      "glow",
      "bevel"
    ],
    "png_fallback_allowed_only_for": []
  },
  "image_generation_constraints": {
    "priority": "Direct semantic vector authoring",
    "avoid": [
      "photorealism",
      "3D render",
      "fur detail",
      "tiny UI details",
      "drop shadow"
    ]
  }
